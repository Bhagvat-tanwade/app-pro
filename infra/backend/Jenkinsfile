// Simple Jenkins Pipeline for Backend Infrastructure

pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'prod'],
            description: 'Select environment'
        )

        choice(
            name: 'ACTION',
            choices: ['create', 'delete'],
            description: 'Select create or delete'
        )
    }

    stages {

        // Get Terraform code from GitHub
        stage('PULL') {
            steps {
                git branch: 'dev', url: 'https://github.com/jambhulkarcloudblitz-alt/app-pro.git'
            }
        }


        // Initialize Terraform
        stage('Terraform Init') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {

                    sh """
                        cd infra/backend/env/${ENVIRONMENT}

                        printf '%s\\n' \\
                          'terraform {' \\
                          '  backend "s3" {' \\
                          '    bucket       = "terraform-state-bucket-cbz-kharadi-04"' \\
                          '    key          = "backend/${ENVIRONMENT}/terraform-global.tfstate"' \\
                          '    region       = "eu-west-1"' \\
                          '    encrypt      = true' \\
                          '    use_lockfile = true' \\
                          '  }' \\
                          '}' > backend.tf

                        rm -rf .terraform

                        terraform init
                    """
                }
            }
        }


        // Show what Terraform will do
        stage('TERRAFORM PLAN') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {

                    sh '''
                        cd infra/backend/env/${ENVIRONMENT}

                        if [ "$ACTION" = "delete" ]; then
                            terraform plan -destroy
                        else
                            terraform plan
                        fi
                    '''
                }
            }
        }


        // Manual approval
        stage('APPROVAL') {
            steps {

                input(
                    message: "Do you want to ${params.ACTION} ${params.ENVIRONMENT} infrastructure?",
                    ok: 'APPROVE'
                )
            }
        }


        // Create or delete infrastructure
        stage('TERRAFORM APPLY') {
            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {

                    sh '''
                        cd infra/backend/env/${ENVIRONMENT}

                        if [ "$ACTION" = "delete" ]; then
                            terraform destroy -auto-approve
                        else
                            terraform apply -auto-approve
                        fi
                    '''
                }
            }
        }


        // Show Terraform outputs
        stage('OUTPUT') {

            when {
                expression {
                    params.ACTION == 'create'
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials']
                ]) {

                    sh '''
                        cd infra/backend/env/${ENVIRONMENT}

                        echo "======================================"
                        echo " Terraform Outputs"
                        echo "======================================"

                        terraform output
                    '''
                }
            }
        }
    }


    post {

        success {
            echo "======================================"
            echo " Jenkins Pipeline Successful"
            echo " Environment: ${params.ENVIRONMENT}"
            echo " Action: ${params.ACTION}"
            echo "======================================"
        }


        failure {
            echo "======================================"
            echo " Jenkins Pipeline Failed"
            echo " Environment: ${params.ENVIRONMENT}"
            echo " Action: ${params.ACTION}"
            echo "======================================"
        }
    }
}
